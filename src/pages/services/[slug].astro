---
import Layout from '../../layouts/Layout.astro';
import ServicePage from '../../components/ServicePage.astro';
import { servicePages } from '../../data/servicePages';
import { pageLd } from '../../data/seo';

export function getStaticPaths() {
  return servicePages.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<Layout lang="ar" path={`services/${s.slug}/`} title={s.ar.title} description={s.ar.desc} jsonLd={pageLd(s, 'ar')}>
  <ServicePage s={s} lang="ar" />
</Layout>
