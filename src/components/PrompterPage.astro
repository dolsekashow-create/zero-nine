---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { ui, type Lang } from '../data/i18n';
import { home, phones, waLink } from '../data/helpers';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const h = home(lang);

/** Monthly subscription price in Egyptian pounds. */
const PRICE = 300;

const copy = {
  ar: {
    name: 'تطبيق الملقن',
    eyebrow: 'تطبيق موبايل من Zero-Nine',
    h1: 'الملقن: صوّر وأنت تقرأ نصّك أمام عينيك',
    lead: 'تطبيق تصوير بملقّن نصوص يتحرك بجانب عدسة الكاميرا، مع فلاتر وتجميل للصورة، وإزالة ضوضاء وصوت بودكاست احترافي، وضغط للفيديو بدون فقدان الجودة. كل المعالجة تتم على هاتفك.',
    subscribe: 'اشترك عبر واتساب',
    waText: 'مرحبا اريد اشتراك في تطبيق الملقن',
    perMonth: 'شهرياً',
    featuresTitle: 'ماذا تحصل عليه',
    features: [
      ['ملقّن نصوص', 'نصّك يتحرك بجانب العدسة بالسرعة وحجم الخط الذي تختاره، فتبدو وكأنك تنظر إلى المشاهد.'],
      ['صوت احترافي', 'إزالة الضوضاء بالذكاء الاصطناعي ونمط «مايك البودكاست» بضبط تلقائي لنبرة الصوت.'],
      ['صورة مصقولة', 'تجميل البشرة وتفتيحها وضبط الإضاءة والتشبع، مع فلاتر ألوان تُحفظ على الفيديو.'],
      ['ضغط الفيديو', 'صغّر حجم فيديوهاتك حتى 60٪ تقريباً مع الحفاظ على الأبعاد والجودة.'],
      ['مكتبة نصوص وجودة Full HD', 'احفظ نصوصك وبدّل بينها بضغطة، وصوّر بدقة 1080p.'],
      ['خصوصية كاملة', 'لا إعلانات ولا تتبّع، وفيديوهاتك لا تغادر هاتفك.'],
    ],
    priceTitle: 'السعر وطريقة الاشتراك',
    priceLine: 'جنيه مصري للاشتراك لمدة 30 يوماً',
    priceNotes: [
      'السعر شامل، بدون أي رسوم إضافية.',
      'تجربة مجانية قصيرة داخل التطبيق قبل الاشتراك.',
      'الاشتراك يعمل على هاتف واحد، ومدته 30 يوماً من وقت التفعيل ولا يتجدد تلقائياً.',
    ],
    stepsTitle: 'خطوات الاشتراك',
    steps: [
      'ثبّت التطبيق وجرّبه، ثم افتح شاشة الاشتراك لتجد «كود جهازك».',
      'تواصل معنا عبر واتساب وأرسل كود جهازك وادفع قيمة الاشتراك.',
      'يصلك كود التفعيل فوراً بعد تأكيد الدفع، تكتبه في التطبيق فيعمل الاشتراك.',
    ],
    deliveryTitle: 'التسليم',
    delivery: 'المنتج رقمي ولا يوجد شحن. يُرسل كود التفعيل عبر واتساب فور تأكيد الدفع، وبحد أقصى خلال 24 ساعة.',
    refundTitle: 'سياسة الاسترداد',
    refund: [
      'يحق لك استرداد كامل المبلغ خلال 3 أيام من تاريخ الدفع إذا لم يعمل التطبيق على هاتفك.',
      'بعد مرور 3 أيام، أو بعد استخدام الاشتراك بشكل طبيعي، لا يُسترد المبلغ.',
      'لطلب الاسترداد تواصل معنا عبر واتساب مع ذكر كود جهازك وبيانات عملية الدفع.',
      'يُردّ المبلغ بنفس وسيلة الدفع خلال 7 إلى 14 يوم عمل، ويُلغى كود الاشتراك.',
    ],
    termsTitle: 'الشروط والأحكام',
    terms: [
      ['قبول الشروط', 'باستخدامك التطبيق أو اشتراكك فيه فأنت توافق على هذه الشروط وعلى سياسة الخصوصية.'],
      ['التجربة والاشتراك', 'يتيح التطبيق تجربة مجانية واحدة قصيرة، وبعدها يتطلب التصوير اشتراكاً مدته 30 يوماً. كود الاشتراك يعمل على الهاتف الذي صدر له فقط ولا يُنقل إلى هاتف آخر.'],
      ['مسؤوليتك عن المحتوى', 'أنت المسؤول عن كل ما تصوّره وتنشره. لا تستخدم التطبيق لتصوير أشخاص دون إذنهم أو لإنتاج محتوى مخالف للقانون.'],
      ['الملكية الفكرية', 'التطبيق وكل مكوّناته مملوكة لـ Zero-Nine ومحمية بحقوق النشر. لا يُسمح بتفكيكه أو تعديله أو إعادة نشره أو تجاوز نظام الاشتراك فيه. الفيديوهات التي تنتجها بالتطبيق ملك لك.'],
      ['حدود المسؤولية', 'يُقدَّم التطبيق «كما هو». نبذل جهدنا ليعمل جيداً، لكننا لا نضمن خلوّه من الأخطاء ولا نتحمّل مسؤولية فقدان أي تسجيل.'],
      ['التعديلات', 'قد نحدّث هذه الشروط مع تحديثات التطبيق، وننشر النسخة الأحدث على هذه الصفحة.'],
    ],
    privacyTitle: 'سياسة الخصوصية',
    privacy: [
      ['الملخّص', 'كل ما تصوّره وتسجّله يُعالَج ويُحفظ على هاتفك فقط. التطبيق لا يرفع فيديوهاتك أو صوتك أو نصوصك إلى أي خادم، ولا يحتوي على إعلانات أو أدوات تتبّع أو تحليلات، ولا يطلب إذن الاتصال بالإنترنت.'],
      ['الأذونات', 'الكاميرا لتصوير الفيديو، والميكروفون لتسجيل صوتك، وحفظ الوسائط لحفظ الفيديو في المعرض، واختيار فيديو من المعرض فقط عند استخدام ميزة ضغط الفيديو.'],
      ['كود الجهاز', 'يُنشئ التطبيق «كود جهاز» قصيراً مشتقاً من معرّف الهاتف لربط الاشتراك بهاتفك. لا يُرسَل تلقائياً إلى أي جهة، ويصلنا فقط إذا أرسلته أنت عند طلب الاشتراك.'],
      ['مشاركة البيانات', 'لا نبيع ولا نشارك أي بيانات شخصية مع أي طرف ثالث، لأن التطبيق لا يجمعها أصلاً. عمليات الدفع الإلكتروني تتم عبر مزوّد دفع مرخّص ولا نحتفظ ببيانات بطاقتك.'],
      ['حذف بياناتك', 'حذف التطبيق من الهاتف يحذف كل ما خزّنه. الفيديوهات التي حفظتها في المعرض تبقى ملكك.'],
      ['الأطفال', 'التطبيق غير موجّه للأطفال دون 13 عاماً.'],
    ],
    contactTitle: 'بيانات التواصل',
    contactPhone: 'الهاتف / واتساب',
    contactAddress: 'العنوان',
    contactHours: 'مواعيد العمل',
    contactEmail: 'البريد الإلكتروني',
    city: site.contact.city_ar,
    hours: site.contact.hours_ar,
    updated: 'آخر تحديث: أكتوبر 2026',
  },
  en: {
    name: 'Prompter app',
    eyebrow: 'A mobile app by Zero-Nine',
    h1: 'Prompter: film while your script scrolls beside the lens',
    lead: 'A camera app with a teleprompter that scrolls next to the lens, picture filters and beautification, AI noise removal with a professional podcast sound, and video compression that keeps the quality. Everything is processed on your phone.',
    subscribe: 'Subscribe on WhatsApp',
    waText: 'Hello, I would like to subscribe to the Prompter app',
    perMonth: 'per month',
    featuresTitle: 'What you get',
    features: [
      ['Teleprompter', 'Your script scrolls beside the lens at the speed and size you choose, so you appear to look straight at the viewer.'],
      ['Professional sound', 'AI noise removal and a "podcast microphone" mode that corrects your voice tone automatically.'],
      ['Polished picture', 'Skin smoothing and brightening, lighting and saturation controls, and colour filters baked into the saved video.'],
      ['Video compression', 'Shrink your videos by around 60% while keeping their dimensions and quality.'],
      ['Script library and Full HD', 'Save your scripts and switch between them in a tap, and film in 1080p.'],
      ['Full privacy', 'No ads, no tracking, and your videos never leave your phone.'],
    ],
    priceTitle: 'Price and how to subscribe',
    priceLine: 'Egyptian pounds for a 30-day subscription',
    priceNotes: [
      'The price is all-inclusive, with no extra fees.',
      'A short free trial inside the app before you subscribe.',
      'A subscription works on one phone for 30 days from activation and does not renew automatically.',
    ],
    stepsTitle: 'How to subscribe',
    steps: [
      'Install the app and try it, then open the subscription screen to find your "device code".',
      'Contact us on WhatsApp, send your device code and pay for the subscription.',
      'You receive an activation code as soon as payment is confirmed; enter it in the app and the subscription starts.',
    ],
    deliveryTitle: 'Delivery',
    delivery: 'This is a digital product with no shipping. The activation code is sent over WhatsApp as soon as payment is confirmed, and within 24 hours at most.',
    refundTitle: 'Refund policy',
    refund: [
      'You are entitled to a full refund within 3 days of payment if the app does not work on your phone.',
      'After 3 days, or once the subscription has been used normally, payments are not refunded.',
      'To request a refund, contact us on WhatsApp with your device code and the payment details.',
      'Refunds are made to the original payment method within 7 to 14 business days, and the subscription code is cancelled.',
    ],
    termsTitle: 'Terms and conditions',
    terms: [
      ['Acceptance', 'By using the app or subscribing to it you agree to these terms and to the privacy policy.'],
      ['Trial and subscription', 'The app offers one short free trial; after that, filming requires a 30-day subscription. A subscription code works only on the phone it was issued for and cannot be moved to another phone.'],
      ['Your content', 'You are responsible for everything you film and publish. Do not use the app to film people without their consent or to produce unlawful content.'],
      ['Intellectual property', 'The app and all its components belong to Zero-Nine and are protected by copyright. You may not decompile, modify or redistribute it, or bypass its subscription system. The videos you make with it are yours.'],
      ['Liability', 'The app is provided "as is". We work to keep it reliable, but we do not guarantee it is free of errors and are not liable for the loss of any recording.'],
      ['Changes', 'We may update these terms with app updates and publish the latest version on this page.'],
    ],
    privacyTitle: 'Privacy policy',
    privacy: [
      ['Summary', 'Everything you film and record is processed and stored on your phone only. The app does not upload your videos, audio or scripts to any server, contains no ads, tracking or analytics, and does not request the internet permission.'],
      ['Permissions', 'Camera to record video, microphone to record your voice, saving media to store the video in your gallery, and picking a video from the gallery only when you use video compression.'],
      ['Device code', 'The app derives a short "device code" from the phone\'s identifier to tie a subscription to your phone. It is never sent anywhere automatically; we receive it only if you send it when subscribing.'],
      ['Data sharing', 'We do not sell or share personal data with any third party, because the app does not collect any. Online payments are handled by a licensed payment provider and we do not store your card details.'],
      ['Deleting your data', 'Uninstalling the app deletes everything it stored. Videos you saved to your gallery remain yours.'],
      ['Children', 'The app is not directed at children under 13.'],
    ],
    contactTitle: 'Contact details',
    contactPhone: 'Phone / WhatsApp',
    contactAddress: 'Address',
    contactHours: 'Working hours',
    contactEmail: 'Email',
    city: site.contact.city_en,
    hours: site.contact.hours_en,
    updated: 'Last updated: October 2026',
  },
}[lang];
---
<main id="main">
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="breadcrumb"><a href={h}>{t.home}</a><span aria-hidden="true">/</span><span>{copy.name}</span></nav>
      <div class="page-hero-grid">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.h1}</h1>
          <p class="page-lead">{copy.lead}</p>
          <div class="hero-ctas">
            <a class="btn btn-gold" href={waLink(copy.waText)} target="_blank" rel="noopener"><Icon name="whatsapp" />{copy.subscribe}</a>
            <a class="btn btn-ghost" href="#pricing">{copy.priceTitle}</a>
          </div>
        </div>
        <div class="page-hero-art" aria-hidden="true">
          <Icon name="phone" class="draw is-in" size={160} />
          <div class="from-badge"><strong class="gold-text">{PRICE}</strong><small>{t.currency} {copy.perMonth}</small></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 24px">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.featuresTitle}</h2></div>
      <div class="services-grid">
        {copy.features.map(([title, desc], i) => (
          <div class="card reveal" style={`--d:${i % 3}`}>
            <Icon name="check" class="draw" />
            <h3>{title}</h3>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="wrap">
      <div class="section-head reveal"><h2>{copy.priceTitle}</h2></div>
      <div class="prompter-price reveal">
        <p class="prompter-amount"><strong class="gold-text">{PRICE}</strong> {copy.priceLine}</p>
        <ul>{copy.priceNotes.map((n) => <li>{n}</li>)}</ul>
        <h3>{copy.stepsTitle}</h3>
        <ol>{copy.steps.map((s) => <li>{s}</li>)}</ol>
        <h3>{copy.deliveryTitle}</h3>
        <p>{copy.delivery}</p>
        <a class="btn btn-gold" href={waLink(copy.waText)} target="_blank" rel="noopener"><Icon name="whatsapp" />{copy.subscribe}</a>
      </div>
    </div>
  </section>

  <section class="section" id="refund">
    <div class="wrap prompter-legal">
      <h2>{copy.refundTitle}</h2>
      <ul>{copy.refund.map((r) => <li>{r}</li>)}</ul>
    </div>
  </section>

  <section class="section" id="terms">
    <div class="wrap prompter-legal">
      <h2>{copy.termsTitle}</h2>
      {copy.terms.map(([title, body]) => (<><h3>{title}</h3><p>{body}</p></>))}
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="wrap prompter-legal">
      <h2>{copy.privacyTitle}</h2>
      {copy.privacy.map(([title, body]) => (<><h3>{title}</h3><p>{body}</p></>))}
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap prompter-legal">
      <h2>{copy.contactTitle}</h2>
      <dl class="prompter-contact">
        <dt>{copy.contactPhone}</dt>
        <dd>{phones.map((p) => <a href={waLink(copy.waText, p.wa)} target="_blank" rel="noopener" dir="ltr">{p.display}</a>)}</dd>
        {site.contact.email && (<><dt>{copy.contactEmail}</dt><dd><a href={`mailto:${site.contact.email}`} dir="ltr">{site.contact.email}</a></dd></>)}
        <dt>{copy.contactAddress}</dt>
        <dd>{copy.city}</dd>
        <dt>{copy.contactHours}</dt>
        <dd>{copy.hours}</dd>
      </dl>
      <p class="prompter-updated">{copy.updated}</p>
    </div>
  </section>
</main>

<style>
  .prompter-price { max-width: 820px; margin-inline: auto; padding: clamp(22px, 4vw, 40px); border: 1px solid var(--line-strong); border-radius: var(--radius); background: rgba(19, 17, 13, .6); }
  .prompter-amount { font-size: 1.15rem; margin-bottom: 14px; }
  .prompter-amount strong { font-family: var(--display); font-size: clamp(2.4rem, 6vw, 3.4rem); margin-inline-end: 6px; }
  .prompter-price h3, .prompter-legal h3 { font-size: 1.15rem; margin-block: 26px 8px; color: var(--gold-2); }
  .prompter-price ul, .prompter-price ol, .prompter-legal ul { padding-inline-start: 1.3em; display: grid; gap: 8px; color: var(--text-dim); line-height: 1.9; }
  .prompter-price ul { list-style: disc; }
  .prompter-price ol { list-style: decimal; }
  .prompter-legal ul { list-style: disc; }
  .prompter-price p, .prompter-legal p { color: var(--text-dim); line-height: 1.9; }
  .prompter-price .btn { margin-top: 26px; }
  .prompter-legal { max-width: 820px; }
  .prompter-legal h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); margin-bottom: 18px; }
  .prompter-contact { display: grid; grid-template-columns: max-content 1fr; gap: 10px 24px; }
  .prompter-contact dt { color: var(--gold-2); font-weight: 700; }
  .prompter-contact dd { color: var(--text-dim); display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .prompter-contact a { text-decoration: underline; text-underline-offset: 3px; }
  .prompter-updated { margin-top: 26px; font-size: .9rem; opacity: .75; }
  #refund, #terms, #privacy, #contact { padding-block: clamp(36px, 5vw, 60px); }
</style>
