---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { ui, type Lang } from '../data/i18n';
import { home, hostOf, projectSlug } from '../data/helpers';

interface Props { p: CollectionEntry<'projects'>; lang: Lang; i?: number }
const { p, lang, i = 0 } = Astro.props;
const t = ui[lang];
const detail = `${home(lang)}work/${projectSlug(p.id)}/`;
---
<article class="project reveal" style={`--d:${i % 4}`}>
  <a class="project-media" href={p.data.url} target="_blank" rel="noopener" aria-label={`${p.data.name}: ${t.visit}`}>
    <span class="project-domain">{hostOf(p.data.url)}</span>
    <Picture src={p.data.image} alt={`${p.data.name} — ${p.data.tag}`} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 640, 900]} sizes="(max-width: 1100px) 50vw, 300px" loading="lazy" decoding="async" />
  </a>
  <div class="project-body">
    <div>
      <h3><a href={detail}>{p.data.name}</a></h3>
      {p.data.tag && <span class="project-tag">{p.data.tag}</span>}
    </div>
    <a class="project-go" href={p.data.url} target="_blank" rel="noopener" aria-label={t.visit} tabindex="-1"><Icon name="external" /></a>
  </div>
</article>
