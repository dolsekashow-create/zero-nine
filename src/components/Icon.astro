---
/** Line-art glyphs. Every path has pathLength="1" so CSS can "draw" it (see .draw in global.css). */
interface Props { name: string; class?: string; size?: number }
const { name, class: cls = '', size = 48 } = Astro.props;

const paths: Record<string, string[]> = {
  pyramid: ['M24 6 L44 40 H4 Z', 'M24 6 L30 40', 'M14 23 H34'],
  phone: ['M15 4 H33 a3 3 0 0 1 3 3 V41 a3 3 0 0 1 -3 3 H15 a3 3 0 0 1 -3 -3 V7 a3 3 0 0 1 3 -3 Z', 'M21 9 H27', 'M22 38 H26'],
  cart: ['M4 8 H10 L15 32 H38 L43 14 H12', 'M18 41 a2 2 0 1 0 0.1 0', 'M35 41 a2 2 0 1 0 0.1 0', 'M19 22 H36'],
  eye: ['M3 22 Q24 4 45 22 Q24 36 3 22 Z', 'M24 16 a6 6 0 1 0 0.1 0', 'M22 32 L18 44', 'M30 30 Q36 40 42 38'],
  lotus: ['M24 40 Q14 30 16 14 Q24 20 24 40', 'M24 40 Q34 30 32 14 Q24 20 24 40', 'M24 40 Q8 36 4 24 Q14 24 24 40', 'M24 40 Q40 36 44 24 Q34 24 24 40', 'M24 40 V46'],
  ankh: ['M24 22 C16 18 16 4 24 4 C32 4 32 18 24 22 Z', 'M10 22 H38', 'M24 22 V46'],
  arrow: ['M30 14 L18 24 L30 34', 'M18 24 H40'],
  external: ['M28 8 H40 V20', 'M40 8 L22 26', 'M34 28 V40 H8 V14 H20'],
  whatsapp: ['M8 40 L11 31 A16 16 0 1 1 17 37 Z', 'M18 17 q0 7 6 12 q5 4 9 3 l1 -4 l-5 -2 l-2 2 q-4 -2 -6 -6 l2 -2 l-2 -5 Z'],
  menu: ['M8 14 H40', 'M8 24 H40', 'M8 34 H40'],
  close: ['M12 12 L36 36', 'M36 12 L12 36'],
  check: ['M10 25 L20 34 L38 14'],
  scarab: ['M24 12 a8 9 0 1 1 -0.1 0', 'M24 12 V38', 'M16 18 Q4 14 2 22 Q10 22 16 24', 'M32 18 Q44 14 46 22 Q38 22 32 24', 'M20 10 Q24 4 28 10'],
};
const p = paths[name] ?? paths.ankh;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor"
  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {p.map((d) => <path d={d} pathLength="1" />)}
</svg>
