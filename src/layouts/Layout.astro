---
import '../styles/fonts.css';
import '../styles/global.css';
import cairoAr from '../assets/fonts/cairo-arabic-var.woff2?url';
import cairoLa from '../assets/fonts/cairo-latin-var.woff2?url';
import messiriAr from '../assets/fonts/el-messiri-arabic-700.woff2?url';
import messiriLa from '../assets/fonts/el-messiri-latin-700.woff2?url';
import site from '../data/site.json';
import { ui, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const base = 'https://www.zero--nine.online';
const canonical = lang === 'ar' ? `${base}/` : `${base}/en/`;
const og = `${base}/og-image.jpg`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Zero-Nine',
  alternateName: 'زيرو ناين',
  url: `${base}/`,
  logo: `${base}/logo.png`,
  image: og,
  description: t.metaDesc,
  telephone: `+${site.contact.whatsapp}`,
  contactPoint: [site.contact.whatsapp, site.contact.whatsapp2].filter(Boolean).map((n) => ({
    '@type': 'ContactPoint',
    telephone: `+${n}`,
    contactType: 'customer service',
    availableLanguage: ['Arabic', 'English'],
  })),
  priceRange: '$$',
  areaServed: 'EG',
  address: { '@type': 'PostalAddress', addressLocality: 'Cairo', addressCountry: 'EG' },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
    opens: '10:00',
    closes: '19:00',
  },
  sameAs: [site.contact.facebook].filter(Boolean),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faq.map((f: any) => ({
    '@type': 'Question',
    name: f[`q_${lang}`],
    acceptedAnswer: { '@type': 'Answer', text: f[`a_${lang}`] },
  })),
};
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={`${base}/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${base}/`} />
    <link rel="preload" href={lang === 'ar' ? cairoAr : cairoLa} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lang === 'ar' ? messiriAr : messiriLa} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0a0907" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDesc} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta property="og:site_name" content="Zero-Nine" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </head>
  <body data-wa={site.contact.whatsapp}>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="bg-glyphs" aria-hidden="true"></div>
    <slot />
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
